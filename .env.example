# FestiveAI Environment Configuration Template

# Application Environment
ENVIRONMENT=development
DEBUG=True
PROJECT_NAME="FestiveAI"
VERSION="1.0.0"

# Security & Secrets (Generate strong production keys)
SECRET_KEY=change_this_to_a_secure_random_jwt_signing_key_for_production
# Fernet 32-byte urlsafe base64 encryption key for OAuth tokens at rest
ENCRYPTION_KEY=gAAAAABmFz-mockEncryptionKeyFestiveAI32BytesNeededForFernet=

# Database Configuration (SQLite default for zero-setup local dev; PostgreSQL for production)
DATABASE_URL=sqlite:///./festiveai.db
# PostgreSQL Example:
# DATABASE_URL=postgresql://festiveai:festiveai_secure_pass_2026@localhost:5432/festiveai

# AI & Computer Vision Providers (Options: "gemini", "openai", "mock")
DEFAULT_AI_PROVIDER=mock
GEMINI_API_KEY=
OPENAI_API_KEY=

# Meta / Instagram Graph API Integration
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_REDIRECT_URI=http://localhost:8000/api/v1/accounts/oauth/callback/instagram

# LinkedIn Community Management API Integration
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=http://localhost:8000/api/v1/accounts/oauth/callback/linkedin

# Background Scheduler & Autonomous Rules
AUTONOMOUS_WORKER_INTERVAL_SECONDS=60
DEFAULT_LEAD_TIME_DAYS=7
DEFAULT_PUBLISH_TIME=09:00:00
DEFAULT_TIMEZONE=Asia/Kolkata
